---
// src/components/Hero.astro

const icons = {
  spotify: `<svg width="20" height="20" class="shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.48-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141 C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.281 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.26-1.26 11.28-1.02 15.72 1.62.54.3.72 1.02.42 1.56-.3.42-1.02.6-1.56.3z"/></svg>`,
  soundcloud: `<svg width="20" height="20" class="shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M1.175 12.225c-.05 0-.088.038-.088.088v5.525c0 .05.038.088.088.088h.7c.05 0 .088-.038.088-.088v-5.525c0-.05-.038-.088-.088-.088zm2.087-1.425c-.05 0-.087.038-.087.088v6.95c0 .05.038.088.088.088h.7c.05 0 .088-.038.088-.088v-6.95c0-.05-.038-.088-.088-.088zm2.088-1.225c-.05 0-.088.038-.088.088v8.175c0 .05.038.088.088.088h.7c.05 0 .088-.038.088-.088V9.662c0-.05-.038-.087-.088-.087zm2.088-2.125c-.05 0-.088.038-.088.088v10.3c0 .05.038.088.088.088h.7c.05 0 .088-.038.088-.088v-10.3c0-.05-.038-.088-.088-.088zm2.087-.75c-.05 0-.087.038-.087.088v11.05c0 .05.038.088.088.088h.7c.05 0 .088-.038.088-.088V6.788c0-.05-.038-.088-.088-.088zm13.125 3.325c-.525 0-1.025.125-1.475.35-.35-2.625-2.6-4.65-5.325-4.65-1.125 0-2.175.35-3.025 1.025-.05.038-.075.088-.075.138v10.375c0 .05.038.088.088.088h9.812c1.925 0 3.5-1.575 3.5-3.5 0-1.925-1.575-3.826-3.5-3.826z"/></svg>`,
  mail: `<svg width="20" height="20" class="shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  gmail: `<svg width="18" height="18" class="shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.272H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L12 9.545l8.073-6.052C21.69 2.28 24 3.434 24 5.457z"/></svg>`,
  instagram: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
  tiktok: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-2.901 2.89 2.893 2.893 0 0 1-2.892-2.89 2.893 2.893 0 0 1 2.892-2.891c.288 0 .564.043.824.123v-3.565a6.326 6.326 0 0 0-.824-.055 6.338 6.338 0 0 0-6.336 6.338 6.338 6.338 0 0 0 6.336 6.338 6.338 6.338 0 0 0 6.336-6.338V8.773a8.212 8.212 0 0 0 4.81 1.527V6.852a4.845 4.845 0 0 1-1.03-.166z"/></svg>`,
  youtube: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  rightArrow: `<svg width="18" height="18" class="shrink-0 transition-transform duration-300 group-hover:translate-x-1.5 text-zinc-400 group-hover:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>`,
  chevronDown: `<svg id="form-chevron" width="18" height="18" class="shrink-0 transition-transform duration-300 text-zinc-400 group-hover:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>`
};
---

<section class="flex flex-col items-center py-6 w-full">

  <!-- Profiilikuva -->
  <div class="mb-6">
    <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-2xl p-1 bg-black/40 border border-amber-400/40 backdrop-blur-md shadow-2xl">
      <img
      src="/profile.jpeg"
      alt="TEKNOSTRUKTUR"
      class="w-full h-full object-cover rounded-xl transition-transform duration-500 hover:scale-110"
/>
    </div>
  </div>

  <!-- Artistinimi -->
  <h1 class="text-5xl sm:text-6xl font-black tracking-tight text-white uppercase text-center drop-shadow-md">
    TEKNOSTRUKTUR
  </h1>

  <!-- Genremääritelmä -->
  <p class="font-['JetBrains_Mono',monospace] text-xs sm:text-sm text-amber-400 mt-3 tracking-[0.25em] text-center uppercase font-semibold drop-shadow">
    HOUSE/HARDHOUSE/TRANCE/UKG
  </p>

  <!-- Somerivi -->
  <div class="flex items-center space-x-3.5 mt-6">
    <a
      href="https://instagram.com/tituspaalanen" 
      target="_blank"
      rel="noopener noreferrer"
      class="p-3 rounded-xl bg-black/55 border border-white/15 text-zinc-300 hover:text-amber-400 hover:border-amber-400/60 transition-all duration-300 shadow-lg"
      aria-label="Instagram"
    >
      <Fragment set:html={icons.instagram} />
    </a>

    <a
      href="https://tiktok.com/@teknostruktur" 
      target="_blank"
      rel="noopener noreferrer"
      class="p-3 rounded-xl bg-black/55 border border-white/15 text-zinc-300 hover:text-amber-400 hover:border-amber-400/60 transition-all duration-300 shadow-lg"
      aria-label="TikTok"
    >
      <Fragment set:html={icons.tiktok} />
    </a>

    <a
      href="https://youtube.com/goodtoseeyoutitus" 
      target="_blank"
      rel="noopener noreferrer"
      class="p-3 rounded-xl bg-black/55 border border-white/15 text-zinc-300 hover:text-amber-400 hover:border-amber-400/60 transition-all duration-300 shadow-lg"
      aria-label="YouTube"
    >
      <Fragment set:html={icons.youtube} />
    </a>
  </div>

  <!-- Linkkiryhmä -->
  <div class="w-full max-w-xl mt-8 space-y-3.5">
    
    <!-- 1. Spotify Link -->
    <a
      href="https://open.spotify.com/artist/2wthdlVhsJsxF6l3SEIMyj"
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center justify-between w-full p-4 sm:p-5 rounded-2xl border border-white/15 bg-black/55 backdrop-blur-md hover:bg-black/75 hover:border-amber-400/60 transition-all duration-300 shadow-xl"
    >
      <div class="flex items-center space-x-4">
        <div class="p-3 rounded-xl bg-white/10 text-zinc-200 group-hover:bg-amber-400 group-hover:text-black transition-colors duration-300 shrink-0">
          <Fragment set:html={icons.spotify} />
        </div>
        <div class="flex flex-col text-left">
          <span class="text-[10px] sm:text-xs font-['JetBrains_Mono',monospace] text-pink-300/90 uppercase tracking-widest leading-none mb-1.5 font-semibold">STREAM</span>
          <span class="font-bold text-base sm:text-lg text-white leading-none tracking-tight">Spotify</span>
        </div>
      </div>
      <Fragment set:html={icons.rightArrow} />
    </a>

    <!-- 2. SoundCloud Link -->
    <a
      href="https://soundcloud.com/teknostruktur"
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center justify-between w-full p-4 sm:p-5 rounded-2xl border border-white/15 bg-black/55 backdrop-blur-md hover:bg-black/75 hover:border-amber-400/60 transition-all duration-300 shadow-xl"
    >
      <div class="flex items-center space-x-4">
        <div class="p-3 rounded-xl bg-white/10 text-zinc-200 group-hover:bg-amber-400 group-hover:text-black transition-colors duration-300 shrink-0">
          <Fragment set:html={icons.soundcloud} />
        </div>
        <div class="flex flex-col text-left">
          <span class="text-[10px] sm:text-xs font-['JetBrains_Mono',monospace] text-pink-300/90 uppercase tracking-widest leading-none mb-1.5 font-semibold">STREAM</span>
          <span class="font-bold text-base sm:text-lg text-white leading-none tracking-tight">SoundCloud</span>
        </div>
      </div>
      <Fragment set:html={icons.rightArrow} />
    </a>

    <!-- 3. Contact & Bookings (Aukeava lomake -laatikko) -->
    <div class="w-full rounded-2xl border border-white/15 bg-black/55 backdrop-blur-md overflow-hidden transition-all duration-300 shadow-xl">
      
      <!-- Avausnäppäin -->
      <button
        id="toggle-contact-btn"
        class="group flex items-center justify-between w-full p-4 sm:p-5 text-left cursor-pointer hover:bg-black/40 transition-colors"
      >
        <div class="flex items-center space-x-4 min-w-0">
          <div class="p-3 rounded-xl bg-white/10 text-zinc-200 group-hover:bg-amber-400 group-hover:text-black transition-colors duration-300 shrink-0">
            <Fragment set:html={icons.mail} />
          </div>
          <div class="flex flex-col text-left min-w-0">
            <span class="text-[10px] sm:text-xs font-['JetBrains_Mono',monospace] text-pink-300/90 uppercase tracking-widest leading-none mb-1.5 font-semibold">BOOKINGS & INQUIRIES</span>
            <span class="font-bold text-base sm:text-lg text-white leading-none tracking-tight">
              Contact / Send Message
            </span>
          </div>
        </div>
        <Fragment set:html={icons.chevronDown} />
      </button>

      <!-- Sisäänrakennettu yhteydenottolomake -->
      <div id="contact-form-container" class="hidden p-5 border-t border-white/10 bg-black/40 space-y-4">
        
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-3.5"
        >
          <!-- Web3Forms API-avain (Vaihda tämä omaasi osoitteesta web3forms.com) -->
          <input type="hidden" name="access_key" value="22fa1c25-9255-448a-ae48-7089cbd4a3a9" />
          <input type="hidden" name="subject" value="Uusi yhteydenotto TEKNOSTRUKTUR-sivustolta!" />

          <div>
            <label class="block font-['JetBrains_Mono',monospace] text-[11px] text-amber-400 uppercase tracking-wider mb-1 font-semibold">Name</label>
            <input
              type="text"
              name="name"
              required
              class="w-full px-4 py-2.5 rounded-xl bg-black/60 border border-white/20 text-white placeholder-zinc-500 text-sm focus:outline-none focus:border-amber-400 transition-colors"
            />
          </div>

          <div>
            <label class="block font-['JetBrains_Mono',monospace] text-[11px] text-amber-400 uppercase tracking-wider mb-1 font-semibold">E-mail</label>
            <input
              type="email"
              name="email"
              required
              class="w-full px-4 py-2.5 rounded-xl bg-black/60 border border-white/20 text-white placeholder-zinc-500 text-sm focus:outline-none focus:border-amber-400 transition-colors"
            />
          </div>

          <div>
            <label class="block font-['JetBrains_Mono',monospace] text-[11px] text-amber-400 uppercase tracking-wider mb-1 font-semibold">Text</label>
            <textarea
              name="message"
              required
              rows="3"
              class="w-full px-4 py-2.5 rounded-xl bg-black/60 border border-white/20 text-white placeholder-zinc-500 text-sm focus:outline-none focus:border-amber-400 transition-colors resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 rounded-xl bg-amber-400 text-black font-bold uppercase tracking-wider text-xs hover:bg-amber-300 transition-colors shadow-lg cursor-pointer"
          >
            Send
          </button>
        </form>

        <!-- Vaihtoehtoinen linkki avaamaan Gmail selaimessa -->
        <div class="pt-2 border-t border-white/10 flex items-center justify-between">
          <a
            href="https://mail.google.com/mail/?view=cm&fs=1&to=teknostruktur.music@gmail.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-amber-400 hover:underline font-semibold"
          >
            <Fragment set:html={icons.gmail} />
            Open Gmail
          </a>
        </div>

      </div>
    </div>

    <!-- 4. Musiikkisoitin -->
    <div class="w-full pt-4">
      <div class="flex items-center gap-3 w-full px-1 mb-3">
        <h2 class="font-['JetBrains_Mono',monospace] text-xs text-amber-400 uppercase tracking-widest flex items-center gap-2 shrink-0 font-semibold">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          NEWEST SPOTIFY RELEASE
        </h2>
        <div class="h-[1px] flex-1 bg-white/20"></div>
      </div>

      <div class="p-1.5 rounded-2xl border border-white/15 bg-black/55 backdrop-blur-md shadow-2xl">
        <iframe
          style="border-radius:12px"
          src="https://open.spotify.com/embed/track/75f1FTv0jEihtvh1EwVkSG?si=8af87ea12b5f46f7"
          width="100%"
          height="152"
          frameborder="0"
          allowfullscreen=""
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    </div>

  </div>
</section>

<!-- Skripti yhteydenotto-laatikon avaamiselle -->
<script>
  const toggleBtn = document.getElementById('toggle-contact-btn');
  const formContainer = document.getElementById('contact-form-container');
  const chevron = document.getElementById('form-chevron');

  toggleBtn?.addEventListener('click', () => {
    formContainer?.classList.toggle('hidden');
    chevron?.classList.toggle('rotate-180');
  });
</script>